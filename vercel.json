{
  "version": 2,
  "framework": null,
  "functions": {
    "api/send-email.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 15
    },
    "api/frames.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/gallery.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/upload.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 30
    },
    "api/submit-frame.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 30
    },
    "api/debug.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/migrate.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 60
    },
    "api/delete-photo.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/admin/frames.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/admin/submissions.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/admin/approve.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 30
    },
    "api/admin/reject.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 15
    },
    "public/submit-frame.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "public/admin/login.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "public/admin/index.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "public/admin/review.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "public/admin/logout.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/api/send-email(.php)?",
      "dest": "/api/send-email.php"
    },
    {
      "src": "/api/frames(.php)?",
      "dest": "/api/frames.php"
    },
    {
      "src": "/api/gallery(.php)?",
      "dest": "/api/gallery.php"
    },
    {
      "src": "/api/upload(.php)?",
      "dest": "/api/upload.php"
    },
    {
      "src": "/api/submit-frame(.php)?",
      "dest": "/api/submit-frame.php"
    },
    {
      "src": "/api/debug(.php)?",
      "dest": "/api/debug.php"
    },
    {
      "src": "/api/migrate(.php)?",
      "dest": "/api/migrate.php"
    },
    {
      "src": "/api/delete-photo(.php)?",
      "dest": "/api/delete-photo.php"
    },
    {
      "src": "/api/admin/frames(.php)?",
      "dest": "/api/admin/frames.php"
    },
    {
      "src": "/api/admin/submissions(.php)?",
      "dest": "/api/admin/submissions.php"
    },
    {
      "src": "/api/admin/approve(.php)?",
      "dest": "/api/admin/approve.php"
    },
    {
      "src": "/api/admin/reject(.php)?",
      "dest": "/api/admin/reject.php"
    },
    {
      "src": "/api/cleanup-rejected(.php)?",
      "dest": "/api/cleanup-rejected.php"
    },
    {
      "src": "/submit-frame",
      "dest": "/public/submit-frame.php"
    },
    {
      "src": "/admin/login",
      "dest": "/public/admin/login.php"
    },
    {
      "src": "/admin/logout",
      "dest": "/public/admin/logout.php"
    },
    {
      "src": "/admin/review",
      "dest": "/public/admin/review.php"
    },
    {
      "src": "/admin",
      "dest": "/public/admin/index.php"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}
