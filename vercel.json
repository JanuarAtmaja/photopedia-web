{
  "version": 2,
  "framework": null,
  "functions": {
    "api/send-email.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 15
    },
    "api/frames.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/gallery.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/upload.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 30
    },
    "api/debug.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/migrate.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 60
    },
    "api/delete-photo.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/api/send-email(.php)?",
      "dest": "/api/send-email.php"
    },
    {
      "src": "/api/frames(.php)?",
      "dest": "/api/frames.php"
    },
    {
      "src": "/api/gallery(.php)?",
      "dest": "/api/gallery.php"
    },
    {
      "src": "/api/upload(.php)?",
      "dest": "/api/upload.php"
    },
    {
      "src": "/api/debug(.php)?",
      "dest": "/api/debug.php"
    },
    {
      "src": "/api/migrate(.php)?",
      "dest": "/api/migrate.php"
    },
    {
      "src": "/api/delete-photo(.php)?",
      "dest": "/api/delete-photo.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}

