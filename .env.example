# ============================================================
#  Photopedia — Environment Variables
#  Salin file ini menjadi .env dan isi nilainya
# ============================================================

# --- Resend (Email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Photopedia <noreply@yourdomain.com>

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=photopedia-photos

# --- App ---
APP_URL=https://your-project.vercel.app
APP_ENV=production

# --- Admin API ---
# Token untuk mengamankan endpoint /api/admin/frames
# Generate dengan: openssl rand -hex 32
ADMIN_SECRET=token-rahasia-anda-disini
